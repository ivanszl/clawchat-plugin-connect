{
  "name": "@clawling/clawchat-plugin-connect",
  "version": "0.1.0",
  "description": "ClawChat host adapter with first-party Codex SDK and ACP runtimes.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.25.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@openai/codex-sdk": "0.144.5",
    "cac": "^6.7.14",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.12",
    "tsup": "8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "clawchat-connect": "./dist/src/bin.js"
  }
}
