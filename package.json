{
  "name": "@clawling/clawchat-plugin-connect",
  "version": "0.1.0",
  "description": "Bun-native ClawChat host adapter with first-party Codex SDK and ACP runtimes.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "bun src/bin.ts",
    "build": "bun build ./src/bin.ts ./src/index.ts --target=bun --outdir=dist/src --packages=external --sourcemap=linked",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check . && tsc --noEmit && bun test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.25.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@openai/codex-sdk": "0.144.5",
    "cac": "^6.7.14",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "^1.3.10",
    "typescript": "^5.4.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.10",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "clawchat-connect": "./dist/src/bin.js"
  }
}
