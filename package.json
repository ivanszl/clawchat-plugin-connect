{
  "name": "@clawling/clawchat-plugin-connect",
  "version": "0.1.0-alpha.4",
  "description": "Bun-native bridge from ClawChat Agent Bindings to local coding agent runtimes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XMethues/clawchat-plugin-connect.git"
  },
  "homepage": "https://github.com/XMethues/clawchat-plugin-connect#readme",
  "bugs": {
    "url": "https://github.com/XMethues/clawchat-plugin-connect/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/client",
    "src",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/bin.ts",
    "dev:web": "vite --config vite.config.ts",
    "preview:web": "bun run build:web && bun tests/fixtures/client-preview-server.ts",
    "build": "bun run build:service && bun run build:web",
    "build:service": "bun build ./src/bin.ts ./src/index.ts --target=bun --outdir=dist/src --packages=external --sourcemap=linked",
    "build:web": "vite build --config vite.config.ts",
    "build:binary": "bun run build:web && bun build ./src/bin.ts --compile --minify --outfile=dist/clawchat-connect",
    "clean": "bun -e 'import { rm } from \"node:fs/promises\"; await rm(\"dist\", { recursive: true, force: true })'",
    "prepack": "bun run clean && bun run build",
    "test": "bun test",
    "test:client-web": "bun run build:web && bun tests/integration/client-web.ts",
    "test:integration:codex": "bun tests/integration/codex-app-server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check . && bun run typecheck && bun test && bun run test:client-web"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.7",
    "@astryxdesign/theme-neutral": "0.1.7",
    "@fontsource/figtree": "5.3.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.168.23",
    "@tanstack/react-virtual": "3.14.6",
    "cac": "^6.7.14",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.7",
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "1.61.1",
    "@tanstack/react-query-devtools": "5.101.2",
    "@tanstack/router-plugin": "1.168.23",
    "@types/bun": "^1.3.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.10",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "clawchat-connect": "./dist/src/bin.js"
  }
}
