{
  "name": "@clawling/clawchat-plugin-connect",
  "version": "0.1.0-beta.5",
  "description": "Bun-native bridge from ClawChat Agent Bindings to local coding agent runtimes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XMethues/clawchat-plugin-connect.git"
  },
  "homepage": "https://github.com/XMethues/clawchat-plugin-connect#readme",
  "bugs": {
    "url": "https://github.com/XMethues/clawchat-plugin-connect/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/client",
    "src",
    "README.md",
    "README_zh.md",
    "install.md",
    "CONTRIBUTING.md",
    "scripts/postinstall.ts",
    "vendor/liveware",
    "skills",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/bin.ts",
    "dev:web": "vite --config vite.config.ts",
    "preview:web": "bun run build:web && bun tests/fixtures/client-preview-server.ts",
    "build": "bun run build:service && bun run build:web",
    "build:service": "bun build ./src/bin.ts ./src/index.ts --target=bun --outdir=dist/src --packages=external --sourcemap=linked",
    "build:web": "vite build --config vite.config.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "build:release": "bun scripts/build-release.ts",
    "clean": "bun -e 'import { rm } from \"node:fs/promises\"; await rm(\"dist\", { recursive: true, force: true })'",
    "prepack": "bun run clean && bun scripts/generate-tool-reference.ts && bun scripts/generate-skills-manifest.ts && bun scripts/verify-liveware-bundle.ts && bun run build",
    "postinstall": "bun scripts/postinstall.ts",
    "test": "bun test",
    "test:client-web": "bun run build:web && bun run check:client-localization && bun tests/integration/client-web.ts && bun tests/integration/client-web-localization.ts",
    "test:integration:codex": "bun tests/integration/codex-app-server.ts",
    "test:integration:opencode": "bun tests/integration/opencode-server.ts",
    "test:integration:workbuddy-ai-discovery": "bun tests/integration/workbuddy-ai-task-discovery.ts",
    "test:integration:workbuddy-ai-adoption": "bun tests/integration/workbuddy-ai-task-adoption.ts",
    "test:integration:workbuddy-ai-turn": "bun tests/integration/workbuddy-ai-task-turn.ts",
    "test:integration:workbuddy-ai-ui-concurrency-recovery": "bun tests/integration/workbuddy-ai-task-ui-concurrency-recovery.ts",
    "test:integration:workbuddy-ai-interaction-cancellation": "bun tests/integration/workbuddy-ai-task-interaction-cancellation.ts",
    "test:integration:workbuddy-ai": "bun run test:integration:workbuddy-ai-discovery && bun run test:integration:workbuddy-ai-adoption && bun run test:integration:workbuddy-ai-turn && bun run test:integration:workbuddy-ai-interaction-cancellation && bun run test:integration:workbuddy-ai-ui-concurrency-recovery",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "check:generated": "bun scripts/check-generated.ts",
    "check:client-localization": "bun scripts/check-client-localization.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check:core": "bun run check:generated && biome check . && bun run typecheck && bun test",
    "check": "bun run check:core && bun run test:client-web",
    "test:integration:workbuddy-cn-discovery": "WORKBUDDY_TEST_PROFILE=workbuddy-cn bun tests/integration/workbuddy-ai-task-discovery.ts",
    "test:integration:workbuddy-cn-adoption": "WORKBUDDY_TEST_PROFILE=workbuddy-cn bun tests/integration/workbuddy-ai-task-adoption.ts",
    "test:integration:workbuddy-cn-turn": "WORKBUDDY_TEST_PROFILE=workbuddy-cn bun tests/integration/workbuddy-ai-task-turn.ts",
    "test:integration:workbuddy-cn-ui-concurrency-recovery": "WORKBUDDY_TEST_PROFILE=workbuddy-cn bun tests/integration/workbuddy-ai-task-ui-concurrency-recovery.ts",
    "test:integration:workbuddy-cn-interaction-cancellation": "WORKBUDDY_TEST_PROFILE=workbuddy-cn bun tests/integration/workbuddy-ai-task-interaction-cancellation.ts",
    "test:integration:workbuddy-cn": "bun run test:integration:workbuddy-cn-discovery && bun run test:integration:workbuddy-cn-adoption && bun run test:integration:workbuddy-cn-turn && bun run test:integration:workbuddy-cn-interaction-cancellation && bun run test:integration:workbuddy-cn-ui-concurrency-recovery",
    "test:integration:workbuddy-installation-preflight": "bun tests/integration/workbuddy-installation-preflight.ts",
    "check:release:workbuddy": "bun run test:integration:workbuddy-installation-preflight && bun run test:integration:workbuddy-ai && bun run test:integration:workbuddy-cn && bun run check:core"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@astryxdesign/core": "0.2.0",
    "@astryxdesign/theme-neutral": "0.2.0",
    "@opencode-ai/sdk": "1.18.13",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.168.23",
    "@tanstack/react-virtual": "3.14.6",
    "cac": "^6.7.14",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.2.0",
    "@biomejs/biome": "2.5.4",
    "@formatjs/icu-messageformat-parser": "3.5.15",
    "@playwright/test": "1.61.1",
    "@tanstack/router-plugin": "1.168.23",
    "@types/bun": "^1.3.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.10",
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "clawchat-connect": "./dist/src/bin.js"
  }
}
