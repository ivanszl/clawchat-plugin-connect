{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/XMethues/clawchat-plugin-connect/main/src/plugin/connect-plugin-manifest.schema.json",
  "title": "ClawChat Connect Plugin author manifest v1",
  "description": "The author-owned manifest accepted by the public Plugin Bundle builder. The builder generates artifact metadata from the supplied entry file.",
  "type": "object",
  "required": [
    "manifestVersion",
    "interfaceVersion",
    "pluginId",
    "version",
    "dependencies",
    "installationConfigurationSchema",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "const": 1 },
    "interfaceVersion": { "const": "1" },
    "pluginId": { "$ref": "#/$defs/identity" },
    "version": { "$ref": "#/$defs/nonBlankText" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hostDependency" }
    },
    "installationConfigurationSchema": { "type": "object" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/runtimeCapability" },
          { "$ref": "#/$defs/managedWebAppCapability" },
          { "$ref": "#/$defs/exposureCapability" },
          { "$ref": "#/$defs/clientExtensionCapability" }
        ]
      }
    }
  },
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "pattern": "\\S"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._@/-]*[a-z0-9])?$"
    },
    "configurationSchema": {
      "type": "object"
    },
    "hostDependency": {
      "type": "object",
      "required": ["type", "id", "interfaceVersion"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "host" },
        "id": { "enum": ["runtime-provider", "managed-web-app-provider", "exposure-provider", "durable-state"] },
        "interfaceVersion": { "const": "1" }
      }
    },
    "runtimeCapability": {
      "type": "object",
      "required": ["id", "type", "interfaceVersion", "family", "configurationSchema"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "type": { "const": "runtime" },
        "interfaceVersion": { "const": "1" },
        "family": { "$ref": "#/$defs/identity" },
        "configurationSchema": { "$ref": "#/$defs/configurationSchema" },
        "durableState": { "$ref": "#/$defs/durableState" }
      }
    },
    "runtimeCapabilityRef": {
      "type": "object",
      "required": ["pluginId", "capabilityId"],
      "additionalProperties": false,
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "capabilityId": { "$ref": "#/$defs/identity" }
      }
    },
    "managedWebAppCapability": {
      "type": "object",
      "required": [
        "id",
        "type",
        "interfaceVersion",
        "configurationSchema",
        "displayName",
        "description",
        "nativeRuntimeCapabilityIds",
        "compatibleRuntimes"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "nativeRuntimeCapabilityIds": { "type": "array", "minItems": 1 }
          }
        },
        {
          "properties": {
            "compatibleRuntimes": { "type": "array", "minItems": 1 }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "type": { "const": "managed-web-app" },
        "interfaceVersion": { "const": "1" },
        "configurationSchema": { "$ref": "#/$defs/configurationSchema" },
        "displayName": { "$ref": "#/$defs/nonBlankText" },
        "description": { "$ref": "#/$defs/nonBlankText" },
        "nativeRuntimeCapabilityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        },
        "compatibleRuntimes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/runtimeCapabilityRef" }
        }
      }
    },
    "exposureCapability": {
      "type": "object",
      "required": ["id", "type", "interfaceVersion", "configurationSchema"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "type": { "const": "exposure" },
        "interfaceVersion": { "const": "1" },
        "configurationSchema": { "$ref": "#/$defs/configurationSchema" },
        "durableState": { "$ref": "#/$defs/durableState" }
      }
    },
    "clientExtensionCapability": {
      "type": "object",
      "required": ["id", "type", "interfaceVersion", "configurationSchema", "managedWebApp", "browser"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "type": { "const": "client-extension" },
        "interfaceVersion": { "const": "1" },
        "configurationSchema": { "$ref": "#/$defs/configurationSchema" },
        "managedWebApp": { "$ref": "#/$defs/runtimeCapabilityRef" },
        "browser": { "$ref": "#/$defs/clientExtensionBrowser" }
      }
    },
    "durableState": {
      "type": "object",
      "required": ["schemaVersion", "lifetime", "schema", "migrations"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "lifetime": { "enum": ["installation", "owner", "binding"] },
        "schema": { "$ref": "#/$defs/configurationSchema" },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "integer", "minimum": 1 },
              "to": { "type": "integer", "minimum": 2 }
            }
          }
        }
      }
    },
    "clientExtensionBrowser": {
      "type": "object",
      "required": ["entry", "integrity", "styles", "slots"],
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]{43}=$" },
        "styles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entry", "integrity"],
            "additionalProperties": false,
            "properties": {
              "entry": { "type": "string", "minLength": 1 },
              "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]{43}=$" }
            }
          }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "interfaceVersion", "priority"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["kernel.root.after"] },
              "interfaceVersion": { "const": "1" },
              "priority": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
